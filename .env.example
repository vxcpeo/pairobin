# Kudorix API origin. This backend provides X OAuth, holds and receipt checks.
VITE_API_BASE_URL=http://localhost:8787

# EVM network used by KudorixPayment (Ganache defaults to 1337).
VITE_CHAIN_ID=1337

# Optional direct EIP-1193 bridge for a local Ganache node (8545 for CLI,
# 7545 for Ganache GUI). When set, the wallet dialog shows Local Ganache.
VITE_GANACHE_RPC_URL=http://127.0.0.1:8545

# Optional override when no public/deployment.json is present.
VITE_MARKET_CONTRACT=

# Create a project at https://cloud.walletconnect.com/ for QR/deep-link wallets.
VITE_WALLETCONNECT_PROJECT_ID=

# Canonical origin used in WalletConnect session metadata.
VITE_APP_URL=http://localhost:5173
